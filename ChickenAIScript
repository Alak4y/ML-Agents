using UnityEngine;
using Unity.MLAgents;
using Unity.MLAgents.Actuators;
using Unity.MLAgents.Sensors;
using System;

public class ChickenAgent : Agent
{

    [SerializeField] private Transform _goal;
    [SerializeField] private float _moveSpeed = 1.5f;
    [SerializeField] private float _rotationSpeed = 180f;

    private Renderer _renderer;

    private int _currentEpisode = 0;
    private float _cumulativeReward = 0f;


    float _distance = 0;

    public override void Initialize()
    {
        Debug.Log("Initialize");

        _renderer = GetComponent<Renderer>();
        _currentEpisode = 0;
        _cumulativeReward = 0f;
        
    }

    public override void OnEpisodeBegin()
    {
        Debug.Log("OnEpisodeBegin");

        _currentEpisode++;
        _cumulativeReward = 0f;
        _distance = 0f;
        _renderer.material.color = Color.white;
        SpawnObjects();
    }

    public void SpawnObjects()
    {
        transform.localRotation = Quaternion.identity;
        transform.localPosition = new Vector3(2.55f, 0f, 0f);

        _goal.localPosition = new Vector3(-22.0f,0.25f,0f);
        _distance = (float)(Math.Sqrt(Math.Pow((transform.localPosition.x - _goal.localPosition.x), 2)
            + Math.Pow((transform.localPosition.z - _goal.localPosition.z), 2)));
    }

    public override void CollectObservations(VectorSensor sensor)
    {
        float goalPosX_normalized = _goal.localPosition.x / 5f;
        float goalPosZ_normalized = _goal.localPosition.z / 5f;

        float chickenPosX_normalized = transform.localPosition.x / 5f;
        float chickenPosZ_normalized = transform.localPosition.z / 5f;

        float chickenRotation_normalized = (transform.localRotation.eulerAngles.y / 360f) * 2f - 1f;

        sensor.AddObservation(goalPosX_normalized);
        sensor.AddObservation(goalPosZ_normalized);
        sensor.AddObservation(chickenPosX_normalized);
        sensor.AddObservation(chickenPosZ_normalized);
        sensor.AddObservation(chickenRotation_normalized);

    }

    public override void OnActionReceived(ActionBuffers actions)
    {
        MoveAgent(actions.DiscreteActions);

        float x2 = transform.localPosition.x;
        float x1 = _goal.localPosition.x;
        float z2 = transform.localPosition.z;
        float z1 = _goal.localPosition.z;

        float newDistance = Mathf.Sqrt(Mathf.Pow((x2 - x1), 2) + Mathf.Pow((z2 - z1), 2));

        float safeDistance = Mathf.Max(newDistance, 0.01f);
        float rewardFactor = 1 / (safeDistance + 0.1f);

        float distanceDelta = _distance - newDistance; 
        if (distanceDelta > 0)
        {
            AddReward(0.05f * distanceDelta); 
        }
        else
        {
            AddReward(-0.02f * Mathf.Abs(distanceDelta)); 
        }

        if (actions.DiscreteActions[0] == 0)
        {
            AddReward(-0.01f);
        }

        AddReward(-0.001f);

        _distance = newDistance;

        _cumulativeReward = GetCumulativeReward();
        Debug.Log($"Current Episode: {_currentEpisode} Reward: {_cumulativeReward}");
    }



    public void MoveAgent(ActionSegment<int> act)
    {
        var action = act[0];

        switch(action)
        {
            case 1:
                transform.position += transform.forward * _moveSpeed * Time.deltaTime;
                break;
            case 2:
                transform.Rotate(0f, -_rotationSpeed * Time.deltaTime, 0f);
                break;
            case 3:
                transform.Rotate(0f, _rotationSpeed * Time.deltaTime, 0f);
                break;
        }
    }

    private void OnTriggerEnter(Collider other)
    {
        if(other.gameObject.CompareTag("Goal"))
        {
            _renderer.material.color = Color.green;
            GoalReached();
        }
    }

    private void GoalReached()
    {
        AddReward(1.0f);
        _cumulativeReward = GetCumulativeReward();

        EndEpisode();
        Debug.Log($"Current Episode: {_currentEpisode} Reward:{_cumulativeReward}");
    }

    private void OnCollisionEnter(Collision collision)
    {
        if(collision.gameObject.CompareTag("Wall"))
        {
            AddReward(-0.01f);

            if(_renderer != null)
            {
                _renderer.material.color = Color.red;
            }
        }

        if (collision.gameObject.CompareTag("Street"))
        {
            AddReward(-0.01f);

            if (_renderer != null)
            {
                _renderer.material.color = Color.yellow;
            }
        }
    }

    private void OnCollisionStay(Collision collision)
    {
        if (collision.gameObject.CompareTag("Wall") || collision.gameObject.CompareTag("Street"))
        {
            AddReward(-0.01f * Time.fixedDeltaTime);
        }
    }

    private void OnCollisionExit(Collision collision)
    {
        if (collision.gameObject.CompareTag("Wall") || collision.gameObject.CompareTag("Street"))
        {
            if (_renderer != null)
            {
                _renderer.material.color = Color.white;
            }
        }
    }
}
